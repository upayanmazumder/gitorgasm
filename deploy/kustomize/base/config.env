# Non-secret settings for api, worker, and migrate. Names match core/internal/config/config.go.
# Kustomize generates the ConfigMap `gitorgasm-core` from this file with a content hash in the
# name. A change to a value therefore rolls the pods that use it.
GITORGASM_ENV=production
HTTP_ADDR=:8080
METRICS_ADDR=:9090
COOKIE_SECURE=true
SESSION_TTL=168h
WORKER_CONCURRENCY=4
RECONCILE_INTERVAL=6h
# api pool size. worker.yaml overrides it for the worker.
DB_MAX_CONNS=8
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s
DB_IDLE_IN_TX_TIMEOUT=30s
SHUTDOWN_TIMEOUT=25s
# Placeholder. Overlays set APP_ORIGIN and GITHUB_OAUTH_CALLBACK_URL.
APP_ORIGIN=https://gitorgasm.example.invalid
