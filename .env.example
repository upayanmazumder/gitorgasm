# Copy to .env for `make up-github`. Never commit .env.
# The API starts without the GITHUB_* group; then auth, sync, and webhook routes return 503.
# Set either all GITHUB_* variables or none of them.

# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Frontend origin. The API redirects here after sign-in and checks Origin against it.
APP_ORIGIN=http://localhost:3000

# GitHub App (Settings -> Developer settings -> GitHub Apps). Use a dedicated development App.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM text with \n escapes, or the base64 of the PEM file.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Must match a callback URL registered on the App.
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/v1/auth/callback

# Optional
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# WORKER_CONCURRENCY=4
# RECONCILE_INTERVAL=6h
