# `make env` creates .env.local and a random key. Never commit local secrets.

GITORGASM_ENV=development
DATABASE_URL=postgres://gitorgasm:gitorgasm@127.0.0.1:55432/gitorgasm?sslmode=disable
TEST_DATABASE_URL=postgres://gitorgasm:gitorgasm@127.0.0.1:55432/gitorgasm?sslmode=disable

# `make env` generates this key.
TOKEN_ENCRYPTION_KEY=

APP_ORIGIN=http://localhost:3000
# Use this false value for local HTTP only. Production requires secure cookies.
COOKIE_SECURE=false

# Set all GitHub App values or none. Use a development App.
# Encode the private key as PEM with \n escapes or base64.
# Register http://localhost:3000/api/v1/auth/callback on the App.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CALLBACK_URL=

# Optional (defaults shown)
# HTTP_ADDR=:8080
# METRICS_ADDR=:9090
# SESSION_TTL=168h
# SHUTDOWN_TIMEOUT=25s
# WORKER_CONCURRENCY=4
# RECONCILE_INTERVAL=6h
# DB_MAX_CONNS=10                # api default. Worker default and minimum: 2 x WORKER_CONCURRENCY + 7
# SCORING_BIN=/gitorgasm-score   # Rust score binary; the image ships it. `make run-api` sets a local build
# DB_STATEMENT_TIMEOUT=15s       # migrate runs without it
# DB_LOCK_TIMEOUT=5s
# DB_IDLE_IN_TX_TIMEOUT=30s
# GITHUB_REQUEST_TIMEOUT=20s
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_WEB_BASE_URL=https://github.com
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
